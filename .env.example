# Copy to `.env` and fill in. `.env` is git-ignored; this template is not.
# Nothing here is read automatically — the Claude Agent SDK does not load .env
# files (RULEBOOK §3.4), and neither does this POC. Export these, or load the
# file explicitly in the script that needs them.

# --- PostgreSQL (system of record) ---------------------------------------
# This machine runs PostgreSQL 18 as the service `postgresql-x64-18`.
# NOTE: the real Caliber repo targets 17.11 + pgvector and its ops scripts
# hardcode the 17 bin path — do not copy them verbatim.
#
# The POC uses its OWN database and role. It must never point at Caliber's
# `caliber` database: a demo must not be able to touch product data.
#
# Create them once, as the postgres superuser:
#   psql -U postgres -c "CREATE ROLE caliber_poc LOGIN PASSWORD '<password>';"
#   psql -U postgres -c "CREATE DATABASE caliber_poc OWNER caliber_poc;"
#   psql -U postgres -c "CREATE DATABASE caliber_poc_test OWNER caliber_poc;"
#
# The Windows installer sets the server to the machine locale, so fix both
# databases once (Caliber hit exactly this on the same installer):
#   psql -U postgres -d caliber_poc      -c "ALTER DATABASE caliber_poc      SET timezone='UTC'; ALTER DATABASE caliber_poc      SET datestyle='ISO, YMD';"
#   psql -U postgres -d caliber_poc_test -c "ALTER DATABASE caliber_poc_test SET timezone='UTC'; ALTER DATABASE caliber_poc_test SET datestyle='ISO, YMD';"

POC_DATABASE_URL=postgresql://caliber_poc:CHANGEME@127.0.0.1:5432/caliber_poc

# Set this ONLY to run the store tests against a real server:
#     pytest -m postgres
# Left unset, those tests skip and the whole suite runs with no database at
# all — which is how the 590 offline tests are meant to stay honest.
# POC_TEST_DATABASE_URL=postgresql://caliber_poc:CHANGEME@127.0.0.1:5432/caliber_poc_test

# --- Live LLM calls -------------------------------------------------------
# Never set this in a shell profile or system-wide. Set it for one approved
# run, in that process only (RULEBOOK §2 rule 7).
# CALIBER_ALLOW_LLM=1
